{
  "name": "@nocoolming/page-editor",
  "version": "0.0.1",
  "description": "Core web editor components (minimal MVP) - a simple editable textarea component",
  "keywords": [
    "web-editor",
    "react",
    "editor"
  ],
  "homepage": "https://github.com/nocoolming/ming-page-editor#readme",
  "bugs": {
    "url": "https://github.com/nocoolming/ming-page-editor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nocoolming/ming-page-editor.git"
  },
  "license": "MIT",
  "author": "Mingming Li",
  "module": "dist/index.mjs",
  "main": "dist/index.cjs.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup src/index.ts --watch --dts",
    "prepublishOnly": "pnpm build",
    "build:core": "pnpm --filter ./packages/core build",
    "publish:core": "pnpm --filter ./packages/core build && cd packages/core && npm publish --access public"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}